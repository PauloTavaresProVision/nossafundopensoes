# Copiar para .env e preencher. O ficheiro .env nunca deve ser commitado.

# SMTP para o botão "Quero Ser Contactado" — o mesmo do simulador de
# Empregados Domésticos (copiar os valores SMTP_* do .env desse projecto).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# destino dos pedidos de contacto (por omissão fundos.pensoes@nossaseguros.ao)
EMAIL_FUNDOS_PENSOES=fundos.pensoes@nossaseguros.ao
